@page "/invoice/{name}"
@inject IJSRuntime JS

@code {
    [Parameter]
    public string Name { get; set; }

    private string _path;

    protected override void OnInitialized()
    {
        _path = $"/docs/{Name}";
    }

}

@if (Name.EndsWith(".pdf"))
{
    <iframe src="@_path" width="100%" height="600px"></iframe>
}
else
{
    <img src="@_path" alt="Bild" style="max-width:100%;" />
}