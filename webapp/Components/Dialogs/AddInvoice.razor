@using domain
@using model.Entities
@inject IInvoiceRepository _invoiceRepository
@inject IRepository<Organisation> _organisationRepository
@inject IRepository<Recipient> _recipientRepository
@inject NavigationManager Navigator
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-3 mb-n1"/>
            Rechnung hinzufügen
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @bind-IsValid="_formValid">
            <div class="d-flex justify-center">
                <MudFileUpload T="IBrowserFile" Accept=".pdf, .jpg, .png" FilesChanged="UploadFiles" MaximumFileCount="10" Required="true" RequiredError="Die Rechnung muss hochgeladen werden!">
                    <ActivatorContent>
                        <MudButton Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CloudUpload">
                            Rechnung hochladen
                        </MudButton>
                    </ActivatorContent>
                    <SelectedTemplate>
                        <MudText Align="Align.Center" Typo="Typo.body2">@(context is not null ? context.Name : "Keine Datei ausgewählt.")</MudText>
                    </SelectedTemplate>
                </MudFileUpload>
            </div>
            <MudTextField T="string" Label="Rechnungsnummer" Required="true"
                          RequiredError="Die Rechnungsnummer ist erforderlich!" @bind-Value="_invoiceNr"/>
            <MudDatePicker Label="Ausstellungsdatum" @bind-Date="_date" ShowToolbar="false" Required="true" RequiredError="Das Datum ist erforderlich!"/>
            <MudNumericField @bind-Value="_total" Label="Summe" Required="true" RequiredError="Die Summe ist erforderlich!"/>
            <MudAutocomplete T="Recipient" Label="@(_loading ? "Lädt..." : "Empfänger")" Required="true" RequiredError="Der Empfänger ist erforderlich!" @bind-Value="_selectedRecipient" Disabled="@_loading"
                             SearchFunc="@Search" ToStringFunc="@(e => e == null ? null : $"{e.Name}")"/>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbruch</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="@(!_formValid)">hinzufügen</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; }

    [Parameter] public Organisation Organisation { get; set; }

    private IEnumerable<Recipient> Recipients { get; set; }

    private bool _loading = true;
    
    private bool _formValid = false;

    private Recipient _selectedRecipient;
    private string _invoiceNr;
    private DateTime? _date;
    private decimal _total;
    private IBrowserFile? _file;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        Recipients = await _recipientRepository.GetAllAsync();
        _loading = false;
        StateHasChanged();
    }

    private async Task<IEnumerable<Recipient>> Search(string? value, CancellationToken token)
    {
        if (value is null)
            return Recipients;

        return await Recipients.ToAsyncEnumerable().WhereAwait(async x => x.Name.Contains(value)).ToListAsync(token);
    }
    

    private async Task Submit()
    {
        string extension = _file.Name.Split('.').Last();
        string name = $"{Guid.NewGuid().ToString()}.{extension}";
        string path = $"./wwwroot/docs/{name}";
        await using FileStream fs = new(path, FileMode.Create);
        await _file.OpenReadStream(250000000L).CopyToAsync(fs);

        if (await _invoiceRepository.ExistsAsync(_invoiceNr, Organisation))
        {
            Snackbar.Add($"Diese Rechnungsnummer wurde von {Organisation.Name} bereits ausgestellt.", Severity.Error);
        }
        else
        {
            Invoice invoice = new Invoice()
            {
                Code = _invoiceNr,
                Date = _date.Value,
                IssuedBy = Organisation,
                IssuedById = Organisation.Id,
                Link = $"{Navigator.BaseUri}docs/{name}",
                Paid = false,
                Recipient = _selectedRecipient,
                Total = _total
            };

            await _invoiceRepository.AddAsync(invoice);

            Snackbar.Add("Die Rechnung wurde hinzugefügt.", Severity.Success);
        
            MudDialog.Close(DialogResult.Ok(true));
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private void UploadFiles(IBrowserFile file)
    {
        // TODO: File too big?
        _file = file;
    }

}