@page "/invoices"
@using System.ComponentModel
@using domain
@using Microsoft.EntityFrameworkCore
@using model.DbContext
@using model.Entities
@using webapp.Components.Dialogs
@using webapp.Configuration
@inject IInvoiceRepository repository
@inject IRepository<Organisation> _organisationRepository
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Rechnungen</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Rechnungen</MudText>
<MudText Class="mb-8">Hier siehst du alle Rechnungen, die von deiner Organisation "@(AppState.SelectedOrganization is not null ? AppState.SelectedOrganization.Name : "Lädt...")" ausgestellt wurden.</MudText>

<MudTable Items="@_invoices" Hover="true" Striped="true" Filter="new Func<Invoice,bool>(FilterFunc1)" @bind-SelectedItems="_selectedInvoices" Loading="@_loading" MultiSelection="true" SelectOnRowClick="false">
    <ToolBarContent>
        <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" OverrideStyles="false">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="RefreshData" Variant="Variant.Outlined"></MudIconButton>
            <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="OpenAddDialogAsync" Variant="Variant.Outlined"></MudIconButton>
            <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="DeleteSelection" Color="Color.Error" Variant="Variant.Outlined" Disabled="@(_selectedInvoices.Count == 0)"></MudIconButton>
        </MudButtonGroup>
        <MudSpacer/>
        <MudTextField @bind-Value="_searchString1" Placeholder="Suche" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Rechnungsnr.</MudTh>
        <MudTh>Datum</MudTh>
        <MudTh>An</MudTh>
        <MudTh>Summe</MudTh>
        <MudTh>bezahlt?</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Rechnungsnr.">
            <MudLink Href="@context.Link" Underline="Underline.Hover" Target="_blank">@context.Code</MudLink>
        </MudTd>
        <MudTd DataLabel="Datum">@context.Date.ToShortDateString()</MudTd>
        <MudTd DataLabel="An">@context.Recipient.Name</MudTd>
        <MudTd DataLabel="Summe">@context.Total€</MudTd>
        <MudTd DataLabel="Bezahlt">
            <MudIconButton Icon="@(context.Paid ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)" Color="@(context.Paid ? Color.Success : Color.Error)" OnClick="() => SetPaid(context)"></MudIconButton>
        </MudTd>
    </RowTemplate>
</MudTable>


@code {
    [CascadingParameter] public AppState AppState { get; set; }
    
    IEnumerable<Invoice> _invoices = new List<Invoice>();
    HashSet<Invoice> _selectedInvoices = new HashSet<Invoice>();
    string _searchString1 = "";
    bool _loading;

    protected override async Task OnInitializedAsync()
    {
        await RefreshData();

        AppState.PropertyChanged += SelectedOrganisationChanged;
    }

    private void SelectedOrganisationChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName == nameof(AppState.SelectedOrganization))
        {
            RefreshData();
        }
    }

    async Task RefreshData()
    {
        _loading = true;
        StateHasChanged();
        _invoices = await repository.GetAllByOrganisationAsync(AppState.SelectedOrganization); 
        _loading = false;
        StateHasChanged();
    }
    
    private bool FilterFunc1(Invoice invoice) => FilterFunc(invoice, _searchString1);
    
    private bool FilterFunc(Invoice invoice, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (invoice.Recipient.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (invoice.IssuedBy.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{invoice.Code} {invoice.Total} {invoice.Link}".Contains(searchString))
            return true;
        return false;
    }
    
    private async Task OpenAddDialogAsync()
    {
        var options = new DialogOptions { BackgroundClass = "background-blurry", MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters<AddInvoice>
        {
            { x => x.Organisation, AppState.SelectedOrganization }
        };

        var dialog = await DialogService.ShowAsync<AddInvoice>("Rechnung hinzufügen", parameters, options);
        var result = await dialog.Result;
        
        if (!result.Canceled)
        // TODO: Check if successful -> show Snackbar
            await RefreshData();
    }

    private async Task DeleteSelection()
    {
        foreach (var inv in _selectedInvoices)
        {
            await repository.DeleteAsync(inv);
            // TODO: Rechnung wird nicht gelöscht
        }

        Snackbar.Add("Die ausgewählten Rechnungen wurden gelöscht", Severity.Success);

        await RefreshData();
    }

    private async Task SetPaid(Invoice context)
    {
        context.Paid = !context.Paid;
        await repository.UpdateAsync(context);
        string str = context.Paid ? "bezahlt" : "unbezahlt";
        Snackbar.Add($"Die Rechnung wurde als {str} markiert.", Severity.Success);

        await RefreshData();
    }

}

<style>
    .background-blurry {
        backdrop-filter: blur(10px);
    }
</style>