@page "/invoices"
@using domain
@using Microsoft.EntityFrameworkCore
@using model.DbContext
@using model.Entities
@using webapp.Components.Dialogs
@using webapp.Configuration
@inject IRepository<Invoice> repository
@inject IRepository<Organisation> _organisationRepository
@inject IDialogService DialogService

<PageTitle>Rechnungen</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Rechnungen</MudText>
<MudText Class="mb-8">Hier siehst du alle Rechnungen von @AppState.SelectedOrganization.Name</MudText>

<MudTable Items="@_invoices" Hover="true" Striped="true" Filter="new Func<Invoice,bool>(FilterFunc1)" @bind-SelectedItem="_selectedInvoice" Loading="@_loading">
    <ToolBarContent>
        <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined">
            <MudButton StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshData">Refresh</MudButton>
            <MudButton StartIcon="@Icons.Material.Filled.Receipt" OnClick="OpenAddDialogAsync">Rechnung hinzufügen</MudButton>
        </MudButtonGroup>
        <MudSpacer/>
        <MudTextField @bind-Value="searchString1" Placeholder="Suche" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Rechnungsnr.</MudTh>
        <MudTh>Datum</MudTh>
        <MudTh>An</MudTh>
        <MudTh>Summe</MudTh>
        <MudTh>bezahlt?</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Rechnungsnr.">@context.Code</MudTd>
        <MudTd DataLabel="Datum">@context.Date.ToShortDateString()</MudTd>
        <MudTd DataLabel="An">@context.Recipient.Name</MudTd>
        <MudTd DataLabel="Summe">@context.Total€</MudTd>
        <MudTd DataLabel="Bezahlt">
            @if (context.Paid)
            {
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success"></MudIcon>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error"></MudIcon>
            }
        </MudTd>
    </RowTemplate>
</MudTable>


@code {
    [CascadingParameter] public AppState AppState { get; set; }
    
    IEnumerable<Invoice> _invoices = new List<Invoice>();
    Invoice _selectedInvoice;
    string searchString1;
    bool _loading;

    protected override async Task OnInitializedAsync()
    {
        RefreshData();
    }

    async Task RefreshData()
    {
        Console.WriteLine("reload data");
        _loading = true;
        _invoices = await repository.GetAllAsync(); 
        _loading = false;
        StateHasChanged();
    }
    
    private bool FilterFunc1(Invoice invoice) => FilterFunc(invoice, searchString1);
    
    private bool FilterFunc(Invoice invoice, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (invoice.Recipient.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (invoice.IssuedBy.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{invoice.Code} {invoice.Total} {invoice.Link}".Contains(searchString))
            return true;
        return false;
    }
    
    private async Task OpenAddDialogAsync()
    {
        var options = new DialogOptions { BackgroundClass = "background-blurry", MaxWidth = MaxWidth.Small, FullWidth = true};
        var parameters = new DialogParameters<AddInvoice>
        {
            { x => x.Organisation, AppState.SelectedOrganization }
        };

        var dialog = await DialogService.ShowAsync<AddInvoice>("Rechnung hinzufügen", parameters, options);
        var result = await dialog.Result;
        
        if (!result.Canceled)
        // TODO: Check if successful -> show Snackbar
            await RefreshData();
    }

}

<style>
    .background-blurry {
        backdrop-filter: blur(10px);
    }
</style>